# PLANTILLA DE PRODUCCIÓN. Copiar a `.env` en el servidor del cliente y completar lo marcado con <...>.
# NUNCA subir el `.env` al repositorio. Después de editarlo: php artisan config:cache
# Para comprobar que quedó bien:  php artisan produccion:verificar
#
# Guía completa: api/deploy/PRODUCCION.md

APP_NAME="CCS"
APP_ENV=production
# Se genera una vez con: php artisan key:generate --force   (y NO se cambia: invalida las sesiones)
APP_KEY=
# Apagado SIEMPRE: prendido, cualquier error le muestra rutas y consultas a quien lo provoque.
APP_DEBUG=false
# Con https. Es la URL pública de la API (o del sitio, si el panel y la API comparten dominio).
APP_URL=https://<dominio-del-cliente>

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# warning: en producción "debug" llena el disco con ruido.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<base-del-cliente>
DB_USERNAME=<usuario-de-la-base>
# Una contraseña propia de esta base, nunca la de root.
DB_PASSWORD=<contraseña-de-la-base>

# API con tokens: no usa sesiones de servidor.
SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# El sistema no manda mails todavía.
MAIL_MAILER=log

# --- CCS ---
# Solo el dominio REAL del panel (con https). Si el panel y la API comparten dominio
# (nginx sirviendo /api), se deja vacío. Nunca localhost ni "*".
CORS_ALLOWED_ORIGINS=
SESION_INACTIVIDAD_HORAS=12

# Licencia: en producción SE EXIGE (sin una clave de activación vigente el sistema queda en solo lectura).
# Para una instalación de DEMOSTRACIÓN que no tiene que vencer, poné LICENCIA_EXIGIDA=false.
# LICENCIA_EXIGIDA=

# Contraseña inicial del superadmin. Si se deja VACÍA, el instalador usa la de fábrica y le
# obliga al dueño a elegir la suya en el primer ingreso. Si se define, que sea larga y única.
SUPERADMIN_PASSWORD=

# Copias automáticas (planes Pymes y Corporativo). Vacío = storage/app/respaldos.
RESPALDOS_CARPETA=
RESPALDOS_RETENCION=14

# ---- ARCA (facturación electrónica) ----
# Se deja en homologación hasta que el cliente tenga su certificado y esté listo para facturar de verdad.
ARCA_ENV=homologacion
ARCA_CUIT=
ARCA_PTO_VTA=
# Rutas absolutas FUERA de la carpeta pública del servidor. La clave privada no entra en ningún respaldo.
ARCA_CERT_PATH=
ARCA_KEY_PATH=
ARCA_TIMEOUT_MS=15000
