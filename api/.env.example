# Plantilla de entorno. Copiar a `.env` y completar. NUNCA subir el `.env` al repositorio.
#
# Producción (Hostinger, hosting compartido):
#   APP_ENV=production  APP_DEBUG=false  APP_URL=https://api.tudominio.com
#   CORS_ALLOWED_ORIGINS=https://tudominio.com,https://panel.tudominio.com
#   El document root del subdominio api.* debe apuntar a la carpeta `public/`.

APP_NAME="CheCAT Comercio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL / MariaDB (en Hostinger: datos de la base creada desde el hPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=checat_comercio
DB_USERNAME=root
DB_PASSWORD=

# API pura con tokens: no usa sesiones de servidor.
SESSION_DRIVER=array
SESSION_LIFETIME=120

# Sin workers persistentes en hosting compartido: la cola corre en el mismo request.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- CheCAT ---
# Orígenes del frontend permitidos por CORS (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Horas de inactividad antes de que venza un token de sesión.
SESION_INACTIVIDAD_HORAS=12

# ---- ARCA (facturación electrónica) ----
# Homologación mientras no diga "produccion". El CUIT tiene que ser EXACTAMENTE el del certificado.
ARCA_ENV=homologacion
ARCA_CUIT=
# Punto de venta tipo "Web Services" (numeración propia, distinta de Factura en Línea).
ARCA_PTO_VTA=
# Rutas ABSOLUTAS fuera de public_html (p. ej. /home/usuario/arca/certificado.crt). Sin ellas la facturación queda dormida.
ARCA_CERT_PATH=
ARCA_KEY_PATH=
ARCA_TIMEOUT_MS=15000
